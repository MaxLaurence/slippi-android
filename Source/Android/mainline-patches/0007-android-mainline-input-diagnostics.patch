+static void RecordAndroidInputSample(int chan, const GCPadStatus& pad, u64 now_us)
+{
+  if (!Common::AndroidInputDiagnostics::IsEnabled())
+    return;
+
+  if (chan < 0 || chan >= static_cast<int>(SerialInterface::MAX_SI_CHANNELS))
+    return;
+
+  static std::mutex s_diag_mutex;
+  static std::array<GCPadStatus, SerialInterface::MAX_SI_CHANNELS> s_last_status{};
+  static std::array<bool, SerialInterface::MAX_SI_CHANNELS> s_have_status{};
+  static std::array<u64, SerialInterface::MAX_SI_CHANNELS> s_poll_counts{};
+
+  const u64 payload_us = s_android_last_payload_us.load(std::memory_order_relaxed);
+  const u64 payload_sequence = s_android_payload_sequence.load(std::memory_order_relaxed);
+  const u64 age_us = payload_us > 0 && now_us > payload_us ? now_us - payload_us : 0;
+
+  bool should_log = false;
+  bool changed = false;
+  u64 poll_count = 0;
+  {
+    std::lock_guard<std::mutex> lock(s_diag_mutex);
+    poll_count = ++s_poll_counts[chan];
+    changed = !s_have_status[chan] || !PadStatusEquals(s_last_status[chan], pad);
+    should_log = changed || (poll_count % 120) == 0;
+    if (changed)
+    {
+      s_last_status[chan] = pad;
+      s_have_status[chan] = true;
+    }
