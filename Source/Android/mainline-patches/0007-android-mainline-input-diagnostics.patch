+      static_cast<unsigned long long>(payload_sequence), static_cast<unsigned long long>(age_us),
+      static_cast<unsigned int>(pad.button), static_cast<unsigned int>(pad.stickX),
+      static_cast<unsigned int>(pad.stickY), static_cast<unsigned int>(pad.substickX),
+      static_cast<unsigned int>(pad.substickY), static_cast<unsigned int>(pad.triggerLeft),
+      static_cast<unsigned int>(pad.triggerRight));
+}
