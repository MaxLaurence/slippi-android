Subject: [PATCH 8/8] android: low latency defaults

---
 Source/Core/AudioCommon/OboeStream.cpp       | 21 +++++++++++++++++++-
 Source/Core/Core/Config/GraphicsSettings.cpp |  6 +++---
 Source/Core/Core/Config/MainSettings.cpp     | 12 +++++------
 Source/Core/Core/Slippi/SlippiNetplay.cpp    |  7 +++----
 4 files changed, 32 insertions(+), 14 deletions(-)

diff --git a/Source/Core/AudioCommon/OboeStream.cpp b/Source/Core/AudioCommon/OboeStream.cpp
index c3ff080c716577672065cbace741034f77835ba1..7ea01103c85d363e2d4c08427f843e0b07896fc7 100644
--- a/Source/Core/AudioCommon/OboeStream.cpp
+++ b/Source/Core/AudioCommon/OboeStream.cpp
@@ -19,6 +19,7 @@ namespace
 constexpr const char* TAG = "SlippiAudio";
 constexpr int kMinBufferBursts = 1;
 constexpr int kMaxBufferBursts = 12;
+constexpr int kStableFallbackBursts = 4;
 
 int ConfiguredBufferBursts()
 {
@@ -128,11 +129,29 @@ oboe::DataCallbackResult OboeSoundStream::onAudioReady(oboe::AudioStream* stream
   mixer->Mix(static_cast<s16*>(audio_data), static_cast<std::size_t>(num_frames));
 
   oboe::ResultWithValue<int32_t> xrun_result = stream->getXRunCount();
-  if (xrun_result && xrun_result.value() != m_last_xruns.load())
+  const bool xrun_changed = xrun_result && xrun_result.value() != m_last_xruns.load();
+  if (xrun_changed)
   {
     __android_log_print(ANDROID_LOG_WARN, TAG, "Oboe xruns=%d", xrun_result.value());
     m_last_xruns.store(xrun_result.value());
   }
+  if (xrun_changed && ConfiguredBufferBursts() < kStableFallbackBursts)
+  {
+    const int32_t frames_per_burst = stream->getFramesPerBurst();
+    if (frames_per_burst > 0)
+    {
+      const int32_t capacity = stream->getBufferCapacityInFrames();
+      int32_t target_frames = frames_per_burst * kStableFallbackBursts;
+      if (capacity > 0)
+        target_frames = std::min(target_frames, capacity);
+
+      oboe::ResultWithValue<int32_t> buffer_result = stream->setBufferSizeInFrames(target_frames);
+      if (buffer_result)
+        __android_log_print(ANDROID_LOG_INFO, TAG,
+                            "Oboe xrun fallback targetBuffer=%d actualBuffer=%d",
+                            target_frames, buffer_result.value());
+    }
+  }
 
   return oboe::DataCallbackResult::Continue;
 }
