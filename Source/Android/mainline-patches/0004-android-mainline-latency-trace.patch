+#ifdef __ANDROID__
+namespace
+{
+constexpr const char* LATENCY_TAG = "SlippiLatency";
+
+bool AndroidPropertyEnabled(const char* name)
+{
+  char value[PROP_VALUE_MAX] = {};
+  if (__system_property_get(name, value) <= 0)
+    return false;
+  return std::strcmp(value, "1") == 0 || std::strcmp(value, "true") == 0 ||
+         std::strcmp(value, "TRUE") == 0;
+}
+
+int AndroidPropertyInt(const char* name, int fallback, int minimum, int maximum)
+{
+  char value[PROP_VALUE_MAX] = {};
+  if (__system_property_get(name, value) <= 0)
+    return fallback;
+
+  char* end = nullptr;
+  const long parsed = std::strtol(value, &end, 10);
+  if (end == value)
+    return fallback;
+
+  return std::min(maximum, std::max(minimum, static_cast<int>(parsed)));
+}
+
+bool AndroidLatencyTraceEnabled()
+{
+  static const bool enabled = AndroidPropertyEnabled("debug.slippi.latency_trace");
+  return enabled;
+}
+
+int AndroidActiveServiceTimeoutMs()
+{
+  // Keep the default much lower than upstream's 250 ms wake latency without forcing
+  // the more aggressive 4 ms experiment on every device. Testers can set:
+  // adb shell setprop debug.slippi.netplay_service_timeout_ms 4
+  static const int timeout_ms =
+      AndroidPropertyInt("debug.slippi.netplay_service_timeout_ms", 16, 1, 250);
+  return timeout_ms;
+}
+
+void ConfigureAndroidNetplaySocket(ENetHost* host)
+{
+  if (!host)
+    return;
+
+  const int socket_fd = static_cast<int>(host->socket);
+  if (socket_fd < 0)
+    return;
+
+  int tos = IPTOS_LOWDELAY;
+  int tos_result = setsockopt(socket_fd, IPPROTO_IP, IP_TOS, &tos, sizeof(tos));
+  if (AndroidLatencyTraceEnabled())
+  {
+    __android_log_print(ANDROID_LOG_INFO, LATENCY_TAG,
+                        "mainline netplay socket fd=%d ip_tos_lowdelay=%s activeTimeoutMs=%d",
+                        socket_fd, tos_result == 0 ? "ok" : "failed",
+                        AndroidActiveServiceTimeoutMs());
+  }
+}
+
+void AndroidLogPadSend(int frame, std::size_t queue_size, std::size_t packet_size)
+{
+  if (!AndroidLatencyTraceEnabled())
+    return;
+
+  static u64 s_last_log_us = 0;
+  const u64 now_us = Common::Timer::NowUs();
+  if (s_last_log_us != 0 && now_us - s_last_log_us < 1000000)
+    return;
+  s_last_log_us = now_us;
+
+  __android_log_print(ANDROID_LOG_INFO, LATENCY_TAG,
+                      "mainline padSend frame=%d padOverrideAgeUs=%llu localQueue=%zu packetBytes=%zu",
+                      frame,
+                      static_cast<unsigned long long>(
+                          SerialInterface::SI_PadOverride::LatestSetAgeUs(0)),
+                      queue_size, packet_size);
+}
+}  // namespace
+#endif
+
 static std::mutex pad_mutex;
 static std::mutex ack_mutex;
 
