+  std::shared_ptr<oboe::AudioStream> m_stream;
+  std::atomic<int32_t> m_last_xruns{0};
+};
+
+#else
+
+class OboeSoundStream final : public SoundStream
+{
+public:
+  static bool IsValid() { return false; }
+};
+
