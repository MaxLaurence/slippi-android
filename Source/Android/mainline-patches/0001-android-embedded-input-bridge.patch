 namespace SerialInterface
 {
+namespace
+{
+struct PadOverride
+{
+  std::atomic<bool> active{false};
+  std::atomic<u16> button{0};
+  std::atomic<u8> stick_x{GCPadStatus::MAIN_STICK_CENTER_X};
+  std::atomic<u8> stick_y{GCPadStatus::MAIN_STICK_CENTER_Y};
+  std::atomic<u8> substick_x{GCPadStatus::C_STICK_CENTER_X};
+  std::atomic<u8> substick_y{GCPadStatus::C_STICK_CENTER_Y};
+  std::atomic<u8> trigger_left{0};
+  std::atomic<u8> trigger_right{0};
+  std::atomic<u8> analog_a{0};
+  std::atomic<u8> analog_b{0};
+};
+
+std::array<PadOverride, 4> s_pad_overrides;
+}  // namespace
+
+namespace SI_PadOverride
+{
+void Set(int port, u16 button, u8 stick_x, u8 stick_y, u8 substick_x, u8 substick_y,
+         u8 trigger_left, u8 trigger_right, u8 analog_a, u8 analog_b)
+{
+  if (port < 0 || port >= static_cast<int>(s_pad_overrides.size()))
+    return;
+
+  auto& pad_override = s_pad_overrides[port];
+  pad_override.button.store(button, std::memory_order_relaxed);
+  pad_override.stick_x.store(stick_x, std::memory_order_relaxed);
+  pad_override.stick_y.store(stick_y, std::memory_order_relaxed);
+  pad_override.substick_x.store(substick_x, std::memory_order_relaxed);
+  pad_override.substick_y.store(substick_y, std::memory_order_relaxed);
+  pad_override.trigger_left.store(trigger_left, std::memory_order_relaxed);
+  pad_override.trigger_right.store(trigger_right, std::memory_order_relaxed);
+  pad_override.analog_a.store(analog_a, std::memory_order_relaxed);
+  pad_override.analog_b.store(analog_b, std::memory_order_relaxed);
+  pad_override.active.store(true, std::memory_order_release);
+}
+
+void Clear(int port)
+{
+  if (port < 0 || port >= static_cast<int>(s_pad_overrides.size()))
+    return;
+
+  s_pad_overrides[port].active.store(false, std::memory_order_release);
+}
+
+bool Get(int port, GCPadStatus* out)
+{
+  if (port < 0 || port >= static_cast<int>(s_pad_overrides.size()) || out == nullptr)
+    return false;
+
+  auto& pad_override = s_pad_overrides[port];
+  if (!pad_override.active.load(std::memory_order_acquire))
+    return false;
+
+  out->button = pad_override.button.load(std::memory_order_relaxed);
+  out->stickX = pad_override.stick_x.load(std::memory_order_relaxed);
+  out->stickY = pad_override.stick_y.load(std::memory_order_relaxed);
+  out->substickX = pad_override.substick_x.load(std::memory_order_relaxed);
+  out->substickY = pad_override.substick_y.load(std::memory_order_relaxed);
+  out->triggerLeft = pad_override.trigger_left.load(std::memory_order_relaxed);
+  out->triggerRight = pad_override.trigger_right.load(std::memory_order_relaxed);
+  out->analogA = pad_override.analog_a.load(std::memory_order_relaxed);
+  out->analogB = pad_override.analog_b.load(std::memory_order_relaxed);
+  out->isConnected = true;
+  return true;
+}
+}  // namespace SI_PadOverride
