From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: laurenceputterman <mlputterman@gmail.com>
Date: Sun, 17 May 2026 11:33:10 -0700
Subject: [PATCH 2/9] disable ranked mode on android

---
 Source/Core/Core/HW/EXI/EXI_DeviceSlippi.cpp  | 10 ++++++++++
 Source/Core/Core/Slippi/SlippiMatchmaking.cpp | 16 ++++++++++++++++
 Source/Core/Core/Slippi/SlippiMatchmaking.h   |  1 +
 3 files changed, 27 insertions(+)

diff --git a/Source/Core/Core/HW/EXI/EXI_DeviceSlippi.cpp b/Source/Core/Core/HW/EXI/EXI_DeviceSlippi.cpp
index a06dc4b5b9e69df0e7117faa0caf083786d3a54d..300a95052d917a1180ce33b749ea0e753094820e 100644
--- a/Source/Core/Core/HW/EXI/EXI_DeviceSlippi.cpp
+++ b/Source/Core/Core/HW/EXI/EXI_DeviceSlippi.cpp
@@ -1795,6 +1795,16 @@ void CEXISlippi::startFindMatch(u8* payload)
   SlippiMatchmaking::MatchSearchSettings search;
   search.mode = (SlippiMatchmaking::OnlinePlayMode)payload[0];
 
+#ifdef ANDROID
+  if (search.mode == SlippiMatchmaking::OnlinePlayMode::RANKED)
+  {
+    last_search = search;
+    forced_error = SlippiMatchmaking::RankedDisabledMessage();
+    ERROR_LOG_FMT(SLIPPI_ONLINE, "Ranked matchmaking is disabled on Android");
+    return;
+  }
+#endif
+
   std::string shift_jis_code;
   shift_jis_code.insert(shift_jis_code.begin(), &payload[1], &payload[1] + 18);
   shift_jis_code.erase(std::find(shift_jis_code.begin(), shift_jis_code.end(), 0x00),
diff --git a/Source/Core/Core/Slippi/SlippiMatchmaking.cpp b/Source/Core/Core/Slippi/SlippiMatchmaking.cpp
index 70b39bcf1914f6e026f263b7d5dedfc31e669e45..616bab4428981f8b1124cb597aa40750e0280bb2 100644
--- a/Source/Core/Core/Slippi/SlippiMatchmaking.cpp
+++ b/Source/Core/Core/Slippi/SlippiMatchmaking.cpp
@@ -62,6 +62,17 @@ void SlippiMatchmaking::FindMatch(MatchSearchSettings settings)
 {
   is_mm_connected = false;
 
+#ifdef ANDROID
+  if (settings.mode == SlippiMatchmaking::OnlinePlayMode::RANKED)
+  {
+    m_search_settings = settings;
+    m_error_msg = RankedDisabledMessage();
+    m_state = ProcessState::ERROR_ENCOUNTERED;
+    ERROR_LOG_FMT(SLIPPI_ONLINE, "[Matchmaking] Ranked mode is disabled on Android");
+    return;
+  }
+#endif
+
   ERROR_LOG_FMT(SLIPPI_ONLINE, "[Matchmaking] Starting matchmaking...");
 
   m_search_settings = settings;
@@ -71,6 +82,11 @@ void SlippiMatchmaking::FindMatch(MatchSearchSettings settings)
   m_matchmake_thread = std::thread(&SlippiMatchmaking::MatchmakeThread, this);
 }
 
+const char* SlippiMatchmaking::RankedDisabledMessage()
+{
+  return "Ranked mode is disabled on this Android build";
+}
+
 SlippiMatchmaking::ProcessState SlippiMatchmaking::GetMatchmakeState()
 {
   return m_state;
diff --git a/Source/Core/Core/Slippi/SlippiMatchmaking.h b/Source/Core/Core/Slippi/SlippiMatchmaking.h
index 2087ef6eacb626f923abd34e3102d9ae9a2e4b3f..26705da9bd24bec265d755f1d075e843292d6be6 100644
--- a/Source/Core/Core/Slippi/SlippiMatchmaking.h
+++ b/Source/Core/Core/Slippi/SlippiMatchmaking.h
@@ -94,6 +94,7 @@ public:
   u8 RemotePlayerCount();
   MatchmakeResult GetMatchmakeResult();
   static bool IsFixedRulesMode(OnlinePlayMode mode);
+  static const char* RankedDisabledMessage();
 
 protected:
   const std::string MM_HOST_DEV = "mm2.slippi.gg";  // Dev host
