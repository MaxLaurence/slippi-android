@@ -176,6 +186,44 @@ static u64 s_consecutive_slow_transfers = 0;
 static double s_read_rate = 0.0;
 // slippi change: for poll rate display
 
+#if GCADAPTER_USE_ANDROID_IMPLEMENTATION
+static u64 NowUs()
+{
+  return static_cast<u64>(std::chrono::duration_cast<std::chrono::microseconds>(
+                              std::chrono::steady_clock::now().time_since_epoch())
+                              .count());
+}
+
+static GCPadStatus NeutralPadForStalePayload(int chan, PortState& pad_state, u64 now_us)
+{
+  GCPadStatus pad = {};
+  if (pad_state.controller_type == ControllerType::None)
+  {
+    if (!Core::WantsDeterminism())
+      pad.button = PAD_ERR_STATUS;
+    return pad;
+  }
+
+  pad.stickX = GCPadStatus::MAIN_STICK_CENTER_X;
+  pad.stickY = GCPadStatus::MAIN_STICK_CENTER_Y;
+  pad.substickX = GCPadStatus::C_STICK_CENTER_X;
+  pad.substickY = GCPadStatus::C_STICK_CENTER_Y;
+
+  if (pad_state.last_stale_log_time_us == 0 ||
+      now_us - pad_state.last_stale_log_time_us > 500000)
+  {
+    pad_state.last_stale_log_time_us = now_us;
+    const u64 age_us =
+        now_us > pad_state.last_payload_time_us ? now_us - pad_state.last_payload_time_us : 0;
+    WARN_LOG_FMT(CONTROLLERINTERFACE,
+                 "Android WUP stale report neutralized port={} age_us={} threshold_us={} "
+                 "type_byte={:02x}",
+                 chan, age_us, STALE_PAYLOAD_NEUTRAL_US, pad_state.type_byte);
+  }
+  return pad;
+}
+#endif
+
