From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: laurenceputterman <mlputterman@gmail.com>
Date: Sun, 17 May 2026 11:33:10 -0700
Subject: [PATCH 5/9] android wup stale neutralize

---
 Source/Core/InputCommon/GCAdapter.cpp | 69 ++++++++++++++++++++++++++-
 1 file changed, 67 insertions(+), 2 deletions(-)

diff --git a/Source/Core/InputCommon/GCAdapter.cpp b/Source/Core/InputCommon/GCAdapter.cpp
index 0cd6c4fa8100ea991c4782b5f1953c5779e2f292..9b16ca4f7d421f29014f356e5f0e54155f13d7ad 100644
--- a/Source/Core/InputCommon/GCAdapter.cpp
+++ b/Source/Core/InputCommon/GCAdapter.cpp
@@ -14,6 +14,7 @@
 #include <algorithm>
 #include <array>
 #include <atomic>
+#include <chrono>
 #include <mutex>
 #include <optional>
 
@@ -117,12 +118,21 @@ constexpr size_t CONTROLLER_OUTPUT_INIT_PAYLOAD_SIZE = 1;
 #endif
 constexpr size_t CONTROLLER_OUTPUT_RUMBLE_PAYLOAD_SIZE = 5;
 
+#if GCADAPTER_USE_ANDROID_IMPLEMENTATION
+constexpr u64 STALE_PAYLOAD_NEUTRAL_US = 25000;
+#endif
+
 struct PortState
 {
   GCPadStatus origin = {};
   GCPadStatus status = {};
 
   ControllerType controller_type = ControllerType::None;
+#if GCADAPTER_USE_ANDROID_IMPLEMENTATION
+  u8 type_byte = 0;
+  u64 last_payload_time_us = 0;
+  u64 last_stale_log_time_us = 0;
+#endif
   bool is_new_connection = false;
 };
 
@@ -188,6 +198,44 @@ static std::array<u64, SerialInterface::MAX_SI_CHANNELS> s_game_poll_counts{};
 static std::atomic<ReportCallback> s_report_callback{nullptr};
 // slippi change: input suggestions
 
+#if GCADAPTER_USE_ANDROID_IMPLEMENTATION
+static u64 NowUs()
+{
+  return static_cast<u64>(std::chrono::duration_cast<std::chrono::microseconds>(
+                              std::chrono::steady_clock::now().time_since_epoch())
+                              .count());
+}
+
+static GCPadStatus NeutralPadForStalePayload(int chan, PortState& pad_state, u64 now_us)
+{
+  GCPadStatus pad = {};
+  if (pad_state.controller_type == ControllerType::None)
+  {
+    if (!Core::WantsDeterminism())
+      pad.button = PAD_ERR_STATUS;
+    return pad;
+  }
+
+  pad.stickX = GCPadStatus::MAIN_STICK_CENTER_X;
+  pad.stickY = GCPadStatus::MAIN_STICK_CENTER_Y;
+  pad.substickX = GCPadStatus::C_STICK_CENTER_X;
+  pad.substickY = GCPadStatus::C_STICK_CENTER_Y;
+
+  if (pad_state.last_stale_log_time_us == 0 ||
+      now_us - pad_state.last_stale_log_time_us > 500000)
+  {
+    pad_state.last_stale_log_time_us = now_us;
+    const u64 age_us =
+        now_us > pad_state.last_payload_time_us ? now_us - pad_state.last_payload_time_us : 0;
+    WARN_LOG_FMT(CONTROLLERINTERFACE,
+                 "Android WUP stale report neutralized port={} age_us={} threshold_us={} "
+                 "type_byte={:02x}",
+                 chan, age_us, STALE_PAYLOAD_NEUTRAL_US, pad_state.type_byte);
+  }
+  return pad;
+}
+#endif
+
 static void ReadThreadFunc()
 {
   Common::SetCurrentThreadName("GCAdapter Read Thread");
@@ -843,6 +891,15 @@ GCPadStatus Input(int chan, bool is_game_poll)
 
   auto& pad_state = s_port_states[chan];
 
+#if GCADAPTER_USE_ANDROID_IMPLEMENTATION
+  const u64 now_us = NowUs();
+  if (pad_state.last_payload_time_us > 0 && now_us > pad_state.last_payload_time_us &&
+      now_us - pad_state.last_payload_time_us > STALE_PAYLOAD_NEUTRAL_US)
+  {
+    return NeutralPadForStalePayload(chan, pad_state, now_us);
+  }
+#endif
+
   // Return the "origin" state for the first input on a new connection.
   if (pad_state.is_new_connection)
   {
@@ -887,12 +944,16 @@ void ProcessInputPayload(const u8* data, std::size_t size)
   else
   {
     std::lock_guard lk(s_read_mutex);
+#if GCADAPTER_USE_ANDROID_IMPLEMENTATION
+    const u64 payload_time_us = NowUs();
+#endif
 
     for (int chan = 0; chan != SerialInterface::MAX_SI_CHANNELS; ++chan)
     {
       const u8* const channel_data = &data[1 + (9 * chan)];
 
-      const auto type = IdentifyControllerType(channel_data[0]);
+      const u8 type_byte = channel_data[0];
+      const auto type = IdentifyControllerType(type_byte);
 
       auto& pad_state = s_port_states[chan];
 
@@ -948,7 +1009,7 @@ void ProcessInputPayload(const u8* data, std::size_t size)
       if (type != ControllerType::None && pad_state.controller_type == ControllerType::None)
       {
         NOTICE_LOG_FMT(CONTROLLERINTERFACE, "New device connected to Port {} of Type: {:02x}",
-                       chan + 1, channel_data[0]);
+                       chan + 1, type_byte);
 
         pad.button |= PAD_GET_ORIGIN;
         pad_state.origin = pad;
@@ -957,6 +1018,10 @@ void ProcessInputPayload(const u8* data, std::size_t size)
 
       pad_state.controller_type = type;
       pad_state.status = pad;
+#if GCADAPTER_USE_ANDROID_IMPLEMENTATION
+      pad_state.type_byte = type_byte;
+      pad_state.last_payload_time_us = payload_time_us;
+#endif
     }
 
     // slippi change: input suggestions. Stamped under the same lock the game's polls take, so the
