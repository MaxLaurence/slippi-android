 struct PortState
 {
   GCPadStatus origin = {};
   GCPadStatus status = {};
 
   ControllerType controller_type = ControllerType::None;
+#if GCADAPTER_USE_ANDROID_IMPLEMENTATION
+  u8 type_byte = 0;
