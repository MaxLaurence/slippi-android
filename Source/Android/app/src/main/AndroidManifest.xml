<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="false" />
    <!-- USB host so we can talk to the WUP-028 GameCube adapter directly. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Optional low-latency path: when manually granted on sideloaded/test
         builds, temporarily lifts OEM/user refresh-rate caps during emulation. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <queries>
        <package android:name="com.odin.mapping" />
        <intent>
            <action android:name="com.ro.mapping.action.MAPPING_SERVICE" />
        </intent>
    </queries>

    <application
        android:name="org.dolphinemu.dolphinemu.DolphinApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:isGame="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.SlippiDolphin">

        <activity
            android:name="org.dolphinemu.dolphinemu.activities.MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Auto-launch the app (and implicitly grant USB access for this
                 attachment) when a Nintendo WUP-028 GC adapter is plugged in. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <activity
            android:name="org.dolphinemu.dolphinemu.activities.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_screen_title"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.SlippiDolphin"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard" />

        <activity
            android:name="org.dolphinemu.dolphinemu.activities.EmulationActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard"
            android:theme="@style/Theme.SlippiDolphin.Emulation" />

        <activity
            android:name="org.dolphinemu.dolphinemu.activities.MainlineEmulationActivity"
            android:exported="false"
            android:process=":mainline"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard"
            android:theme="@style/Theme.SlippiDolphin.Emulation" />

        <activity
            android:name="org.dolphinemu.dolphinemu.activities.TrainingModeActivity"
            android:exported="false"
            android:label="@string/training_screen_title"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.SlippiDolphin"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard" />

        <activity
            android:name="org.dolphinemu.dolphinemu.activities.CalibrationActivity"
            android:exported="false"
            android:label="Stick calibration"
            android:theme="@style/Theme.SlippiDolphin"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard" />

        <activity
            android:name="org.dolphinemu.dolphinemu.activities.ButtonMapActivity"
            android:exported="false"
            android:label="Remap buttons"
            android:theme="@style/Theme.SlippiDolphin"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard" />

        <activity
            android:name="org.dolphinemu.dolphinemu.activities.TouchOverlayActivity"
            android:exported="false"
            android:label="Touch controls"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.SlippiDolphin.Emulation"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard" />

        <activity
            android:name="org.dolphinemu.dolphinemu.activities.SlippiLoginActivity"
            android:exported="false"
            android:label="Sign in via slippi.gg"
            android:theme="@style/Theme.SlippiDolphin"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard" />

        <activity
            android:name="org.dolphinemu.dolphinemu.activities.ReplayListActivity"
            android:exported="false"
            android:label="@string/replay_list_title"
            android:theme="@style/Theme.SlippiDolphin"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.replays"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>
</manifest>
