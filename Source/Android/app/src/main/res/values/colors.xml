<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Slippi brand green. Used as adaptive icon background, primary
         accent / button color, and tint for the logo glyph on dark
         surfaces. -->
    <color name="slippi_green">#FF44A963</color>
    <color name="slippi_green_pressed">#FF2F8F4D</color>

    <!-- Dark UI palette tuned to make the green pop without being
         neon-saturated against the rest of the app. -->
    <color name="dark_bg">#FF0B100E</color>
    <color name="card_bg">#FF14201A</color>
    <color name="card_stroke">#FF24322C</color>
    <color name="text_primary">#FFEDEDED</color>
    <color name="text_secondary">#FF8FA398</color>

    <!-- Legacy aliases (in case any leftover references). -->
    <color name="accent">@color/slippi_green</color>

    <!-- GameCube button glyph colors. Used as the small color chips on
         the remap rows so each row reads as the actual physical button
         it represents. Match the GameCube controller's silkscreen. -->
    <color name="gc_a_green">#FF02ABA8</color>
    <color name="gc_b_red">#FFD0473D</color>
    <color name="gc_x_grey">#FFD2D2D2</color>
    <color name="gc_y_grey">#FFD2D2D2</color>
    <color name="gc_z_purple">#FF8351E5</color>
    <color name="gc_trigger">#FF8FA0A8</color>
    <color name="gc_start_red">#FFD0473D</color>
    <color name="gc_dpad">#FF6B7A75</color>
</resources>
