<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Slippi/Replays under app-owned internal/external storage. The tree is exposed
         because the user picks specific files via the share menu;
         these are the only paths in these roots we hand out URIs for. -->
    <files-path
        name="legacy_replays"
        path="dolphin/Slippi/Replays/"/>
    <external-files-path
        name="replays"
        path="Slippi/Replays/"/>
    <files-path
        name="diagnostics"
        path="diagnostics/"/>
</paths>
