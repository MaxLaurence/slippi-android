<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:padding="20dp">

    <!-- Title: Slippi logo + wordmark -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="44dp"
        android:layout_height="32dp"
        android:src="@drawable/slippi_logo"
        android:contentDescription="@string/app_name"
        app:tint="@color/text_primary"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/header_title"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/logo"
        app:layout_constraintEnd_toStartOf="@id/build_chip"/>

    <TextView
        android:id="@+id/build_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/build_chip"
        android:textColor="@color/slippi_green"
        android:textSize="11sp"
        android:background="@drawable/chip_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toTopOf="@id/title"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Two side-by-side cards: ISO + user.json -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_iso"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/card_user"
        app:layout_constraintWidth_percent="0.5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/iso_section"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"/>

            <TextView
                android:id="@+id/iso_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/iso_label_empty"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="middle"/>

            <Button
                android:id="@+id/pick_iso"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/pick_iso"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_user"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="8dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toEndOf="@id/card_iso"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/account_section"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"/>

            <!-- Resume / loading state. Visible while we refresh tokens
                 in the background on cold start. -->
            <LinearLayout
                android:id="@+id/auth_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:visibility="gone">
                <ProgressBar
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminateTint="@color/slippi_green"/>
                <TextView
                    android:id="@+id/auth_loading_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:text="@string/auth_resuming"/>
            </LinearLayout>

            <!-- Logged-out state. Single "Sign in via slippi.gg"
                 button opens SlippiLoginActivity (an embedded WebView
                 that handles the auth + serves the user.json). Manual
                 import is still offered for power users who already
                 have a user.json on disk. -->
            <LinearLayout
                android:id="@+id/auth_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/auth_explainer"/>

                <Button
                    android:id="@+id/auth_sign_in"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    app:backgroundTint="@color/slippi_green"
                    android:textColor="#FF0B100E"
                    android:textStyle="bold"
                    android:text="@string/auth_sign_in"/>

                <TextView
                    android:id="@+id/auth_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#FFEF6464"
                    android:textSize="12sp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/auth_import_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/slippi_green"
                    android:textSize="12sp"
                    android:text="@string/auth_import_link"/>

                <!-- Kept around so existing findViewById calls don't
                     NPE; not part of the new flow. -->
                <EditText
                    android:id="@+id/auth_email"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"/>
                <EditText
                    android:id="@+id/auth_password"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Logged-in state: who you are + sign-out. -->
            <LinearLayout
                android:id="@+id/auth_signed_in"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/auth_display_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/auth_connect_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="monospace"/>

                <Button
                    android:id="@+id/auth_sign_out"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/auth_sign_out"
                    android:textColor="@color/text_secondary"
                    android:paddingHorizontal="0dp"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Graphics backend toggle -->
    <TextView
        android:id="@+id/graphics_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/graphics_label"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toBottomOf="@id/card_iso"
        app:layout_constraintStart_toStartOf="parent"/>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/backend_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:layout_constraintTop_toBottomOf="@id/graphics_label"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/backend_vulkan"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/backend_vulkan"/>
        <Button
            android:id="@+id/backend_ogl"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/backend_ogl"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/adapter_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:text="@string/adapter_none"
        app:layout_constraintTop_toTopOf="@id/backend_toggle"
        app:layout_constraintBottom_toBottomOf="@id/backend_toggle"
        app:layout_constraintStart_toEndOf="@id/backend_toggle"/>

    <TextView
        android:id="@+id/calibrate_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/slippi_green"
        android:textSize="13sp"
        android:text="@string/calibrate_sticks_link"
        android:padding="6dp"
        app:layout_constraintTop_toTopOf="@id/backend_toggle"
        app:layout_constraintBottom_toBottomOf="@id/backend_toggle"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/remap_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/slippi_green"
        android:textSize="13sp"
        android:text="@string/remap_buttons_link"
        android:padding="6dp"
        app:layout_constraintTop_toBottomOf="@id/calibrate_link"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/touch_overlay_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/slippi_green"
        android:textSize="13sp"
        android:text="@string/touch_controls_link"
        android:padding="6dp"
        app:layout_constraintTop_toBottomOf="@id/remap_link"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Bottom action bar: PLAY and REPLAYS are the two primary
         entry points. Equal-width chain so neither dominates; PLAY
         is filled green (live game = the "go" action), REPLAYS is
         tonal so it reads as an equally available alternative
         rather than secondary. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottom_actions_midline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5"/>

    <Button
        android:id="@+id/play"
        style="@style/Widget.Material3.Button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="4dp"
        android:text="@string/play"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/slippi_green"
        android:textColor="#FF0B100E"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bottom_actions_midline"/>

    <Button
        android:id="@+id/replays_button"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="4dp"
        android:text="@string/replays_button"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/bottom_actions_midline"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
