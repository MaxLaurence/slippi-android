<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:padding="20dp">

    <!-- Title: Slippi logo + wordmark -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="44dp"
        android:layout_height="32dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/slippi_logo"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/text_primary"/>

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/header_title"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/build_chip"
        app:layout_constraintStart_toEndOf="@id/logo"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/build_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/chip_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="@string/build_chip"
        android:textColor="@color/slippi_green"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/title"/>

    <!-- Two side-by-side cards: ISO + user.json -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_iso"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toStartOf="@id/card_user"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintWidth_percent="0.5"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/iso_section"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/iso_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="middle"
                android:maxLines="2"
                android:text="@string/iso_label_empty"
                android:textColor="@color/text_primary"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/pick_iso"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/pick_iso"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_user"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/card_iso"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintWidth_percent="0.5"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/account_section"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>

            <LinearLayout
                android:id="@+id/auth_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminateTint="@color/slippi_green"/>

                <TextView
                    android:id="@+id/auth_loading_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/auth_resuming"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/auth_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/auth_explainer"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>

                <Button
                    android:id="@+id/auth_sign_in"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/auth_sign_in"
                    android:textColor="#FF0B100E"
                    android:textStyle="bold"
                    app:backgroundTint="@color/slippi_green"/>

                <TextView
                    android:id="@+id/auth_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#FFEF6464"
                    android:textSize="12sp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/auth_import_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/auth_import_link"
                    android:textColor="@color/slippi_green"
                    android:textSize="12sp"/>

                <EditText
                    android:id="@+id/auth_email"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"/>

                <EditText
                    android:id="@+id/auth_password"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/auth_signed_in"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/auth_display_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/auth_connect_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"/>

                <Button
                    android:id="@+id/auth_sign_out"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="0dp"
                    android:text="@string/auth_sign_out"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Graphics backend toggle -->
    <TextView
        android:id="@+id/graphics_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:letterSpacing="0.1"
        android:text="@string/graphics_label"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_iso"/>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/backend_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/graphics_label"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button
            android:id="@+id/backend_vulkan"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/backend_vulkan"/>

        <Button
            android:id="@+id/backend_ogl"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/backend_ogl"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/adapter_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/adapter_none"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/backend_toggle"
        app:layout_constraintStart_toEndOf="@id/backend_toggle"
        app:layout_constraintTop_toTopOf="@id/backend_toggle"/>

    <TextView
        android:id="@+id/audio_settings_link"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:padding="6dp"
        android:text="@string/audio_status_default"
        android:textColor="@color/slippi_green"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/backend_toggle"
        app:layout_constraintEnd_toStartOf="@id/calibrate_link"
        app:layout_constraintStart_toEndOf="@id/adapter_status"
        app:layout_constraintTop_toTopOf="@id/backend_toggle"/>

    <TextView
        android:id="@+id/calibrate_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:text="@string/calibrate_sticks_link"
        android:textColor="@color/slippi_green"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/backend_toggle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/backend_toggle"/>

    <TextView
        android:id="@+id/remap_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:text="@string/remap_buttons_link"
        android:textColor="@color/slippi_green"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/calibrate_link"/>

    <TextView
        android:id="@+id/touch_overlay_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:text="@string/touch_controls_link"
        android:textColor="@color/slippi_green"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/remap_link"/>

    <!-- Bottom action bar. Same launcher treatment as before, with
         Training Mode added as the middle entry point. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottom_actions_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.3333"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottom_actions_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.6667"/>

    <Button
        android:id="@+id/play"
        style="@style/Widget.Material3.Button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="4dp"
        android:text="@string/play"
        android:textColor="#FF0B100E"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/slippi_green"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bottom_actions_first"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/training_mode_button"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="6dp"
        android:layout_marginBottom="4dp"
        android:text="@string/training_mode_button"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bottom_actions_second"
        app:layout_constraintStart_toEndOf="@id/bottom_actions_first"/>

    <Button
        android:id="@+id/replays_button"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="4dp"
        android:text="@string/replays_button"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/bottom_actions_second"/>
</androidx.constraintlayout.widget.ConstraintLayout>
